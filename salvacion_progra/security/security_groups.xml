<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_biblioteca" model="ir.module.category">
        <field name="name">Biblioteca UTE</field>
        <field name="description">Control de accesos para el sistema de biblioteca</field>
    </record>

    <record id="group_biblioteca_user" model="res.groups">
        <field name="name">Lector / Usuario UTE</field>
        <field name="category_id" ref="module_category_biblioteca"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_biblioteca_admin" model="res.groups">
        <field name="name">Bibliotecario / Administrador UTE</field>
        <field name="category_id" ref="module_category_biblioteca"/>
        <field name="implied_ids" eval="[(4, ref('group_biblioteca_user'))]"/>
    </record>
</odoo>