<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_jj_academia_docente" model="ir.module.category">
        <field name="name">JJ Academia Docentes</field>
        <field name="sequence">22</field>
    </record>

    <record id="group_jj_docente_usuario" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_jj_academia_docente"/>
    </record>

    <record id="group_jj_docente_administrador" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_jj_academia_docente"/>
        <field name="implied_ids" eval="[(4, ref('group_jj_docente_usuario'))]"/>
    </record>
</odoo>
