<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jj_docente_list" model="ir.ui.view">
        <field name="name">jj.docente.list</field>
        <field name="model">jj.docente</field>
        <field name="arch" type="xml">
            <list string="Docentes">
                <field name="name"/>
                <field name="identification"/>
                <field name="contract_type"/>
                <field name="specialty"/>
                <field name="weekly_hours"/>
                <field name="hourly_rate"/>
                <field name="monthly_salary"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_jj_docente_form" model="ir.ui.view">
        <field name="name">jj.docente.form</field>
        <field name="model">jj.docente</field>
        <field name="arch" type="xml">
            <form string="Docente">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="identification"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="active"/>
                            <field name="hire_date"/>
                        </group>
                        <group>
                            <field name="contract_type"/>
                            <field name="hourly_rate"/>
                            <field name="weekly_hours"/>
                            <field name="monthly_salary" readonly="1"/>
                            <field name="has_master_degree"/>
                            <field name="specialty"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Biografia">
                            <field name="biography"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jj_docente" model="ir.actions.act_window">
        <field name="name">Docentes</field>
        <field name="res_model">jj.docente</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_jj_docente_root" name="JJ Docentes" sequence="30" groups="group_jj_docente_usuario,group_jj_docente_administrador"/>
    <menuitem id="menu_jj_docente" name="Docentes" parent="menu_jj_docente_root" action="action_jj_docente" sequence="10"/>
</odoo>
