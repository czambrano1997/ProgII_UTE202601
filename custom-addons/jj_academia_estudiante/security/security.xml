<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_jj_academia_estudiante" model="ir.module.category">
        <field name="name">JJ Academia Estudiantes</field>
        <field name="sequence">21</field>
    </record>

    <record id="group_jj_estudiante_usuario" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_jj_academia_estudiante"/>
    </record>

    <record id="group_jj_estudiante_administrador" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_jj_academia_estudiante"/>
        <field name="implied_ids" eval="[(4, ref('group_jj_estudiante_usuario'))]"/>
    </record>
</odoo>
