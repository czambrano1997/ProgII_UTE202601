<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_jj_academia_carrera" model="ir.module.category">
        <field name="name">JJ Academia Carreras</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_jj_carrera_usuario" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_jj_academia_carrera"/>
    </record>

    <record id="group_jj_carrera_administrador" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_jj_academia_carrera"/>
        <field name="implied_ids" eval="[(4, ref('group_jj_carrera_usuario'))]"/>
    </record>
</odoo>
