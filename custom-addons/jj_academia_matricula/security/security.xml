<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_jj_academia_matricula" model="ir.module.category">
        <field name="name">JJ Academia Matriculas</field>
        <field name="sequence">24</field>
    </record>

    <record id="group_jj_matricula_usuario" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_jj_academia_matricula"/>
    </record>

    <record id="group_jj_matricula_administrador" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_jj_academia_matricula"/>
        <field name="implied_ids" eval="[(4, ref('group_jj_matricula_usuario'))]"/>
    </record>
</odoo>
