<odoo>
    <!-- Form view -->
    <record id="kw_inscripcion_view_form" model="ir.ui.view">
        <field name="name">kw.inscripcion.form</field>
        <field name="model">kw.inscripcion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="taller_id"/>
                        <field name="participante_id"/>
                    </group>
                    <group>
                        <field name="fecha_inscripcion"/>
                        <field name="estado" widget="statusbar"/>
                        <field name="pago_realizado"/>
                    </group>
                    <field name="codigo_qr"/>
                    <notebook>
                        <page string="Pagos">
                            <field name="pago_ids">
                                <tree>
                                    <field name="monto"/>
                                    <field name="fecha_pago"/>
                                    <field name="metodo"/>
                                    <field name="referencia"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="action_confirmar" string="Confirmar" type="object" class="btn-primary" attrs="{'invisible': [('estado', 'not in', ['interesado'])]}"/>
                        <button name="action_cancelar" string="Cancelar" type="object" class="btn-secondary" attrs="{'invisible': [('estado', 'in', ['cancelado', 'completado'])]}"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view -->
    <record id="kw_inscripcion_view_tree" model="ir.ui.view">
        <field name="name">kw.inscripcion.tree</field>
        <field name="model">kw.inscripcion</field>
        <field name="arch" type="xml">
            <tree>
                <field name="taller_id"/>
                <field name="participante_id"/>
                <field name="estado"/>
                <field name="fecha_inscripcion"/>
                <field name="pago_realizado"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="kw_inscripcion_action" model="ir.actions.act_window">
        <field name="name">Inscripciones</field>
        <field name="res_model">kw.inscripcion</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>