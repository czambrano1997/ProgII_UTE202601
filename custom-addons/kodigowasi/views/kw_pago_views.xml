<odoo>
    <record id="kw_pago_view_form" model="ir.ui.view">
        <field name="name">kw.pago.form</field>
        <field name="model">kw.pago</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="inscripcion_id" />
                        <field name="monto" />
                        <field name="fecha_pago" />
                    </group>
                    <group>
                        <field name="metodo" />
                        <field name="referencia" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kw_pago_view_tree" model="ir.ui.view">
        <field name="name">kw.pago.tree</field>
        <field name="model">kw.pago</field>
        <field name="arch" type="xml">
            <list>
                <field name="inscripcion_id" />
                <field name="monto" />
                <field name="fecha_pago" />
                <field name="metodo" />
            </list>
        </field>
    </record>

    <!-- <record id="kw_pago_action" model="ir.actions.act_window">
        <field name="name">Pagos</field>
        <field name="res_model">kw.pago</field>
        <field name="view_mode">tree,form</field>
    </record> -->
</odoo>