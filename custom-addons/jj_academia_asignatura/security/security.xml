<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_jj_academia_asignatura" model="ir.module.category">
        <field name="name">JJ Academia Asignaturas</field>
        <field name="sequence">23</field>
    </record>

    <record id="group_jj_asignatura_usuario" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_jj_academia_asignatura"/>
    </record>

    <record id="group_jj_asignatura_administrador" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_jj_academia_asignatura"/>
        <field name="implied_ids" eval="[(4, ref('group_jj_asignatura_usuario'))]"/>
    </record>
</odoo>
