<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_comida_ingrediente_list" model="ir.ui.view">
        <field name="name">comida.ingrediente.list</field>
        <field name="model">comida.ingrediente</field>
        <field name="arch" type="xml">
            <list string="Inventario de Ingredientes">
                <field name="name"/>
                <field name="stock"/>
            </list>
        </field>
    </record>

    <record id="view_comida_ingrediente_form" model="ir.ui.view">
        <field name="name">comida.ingrediente.form</field>
        <field name="model">comida.ingrediente</field>
        <field name="arch" type="xml">
            <form string="Ingrediente">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="stock"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_comida_ingrediente" model="ir.actions.act_window">
        <field name="name">Stock de Insumos</field>
        <field name="res_model">comida.ingrediente</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>