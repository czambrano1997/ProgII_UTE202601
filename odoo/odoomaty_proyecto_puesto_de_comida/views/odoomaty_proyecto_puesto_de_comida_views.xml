<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Secuenciador Automático para el número de pedido -->
    <record id="seq_food_order" model="ir.sequence">
        <name>Secuencia de Pedidos de Comida</name>
        <code>food.order</code>
        <prefix>ORD-</prefix>
        <padding>4</padding>
        <company_id eval="False"/>
    </record>

    <!-- Vista de Lista (Tree) -->
    <record id="view_food_order_tree" model="ir.ui.view">
        <name>food.order.tree</name>
        <model>food.order</model>
        <arch TYPE="xml">
            <list string="Pedidos" decoration-info="state == 'cooking'" decoration-success="state == 'ready'">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="order_date"/>
                <field name="amount_total" sum="Total General"/>
                <field name="state" widget="badge" decoration-warning="state == 'draft'" decoration-info="state == 'cooking'" decoration-success="state == 'ready' or state == 'delivered'"/>
            </list>
        </arch>
    </record>

    <!-- Vista Formulario (Form) -->
    <record id="view_food_order_form" model="ir.ui.view">
        <name>food.order.form</name>
        <model>food.order</model>
        <arch TYPE="xml">
            <form string="Pedido de Comida">
                <header>
                    <button name="action_kitchen" string="Mandar a Cocina" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_ready" string="Plato Listo" type="object" class="oe_highlight" invisible="state != 'cooking'"/>
                    <button name="action_deliver" string="Entregar al Cliente" type="object" class="oe_highlight" invisible="state != 'ready'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('delivered', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,cooking,ready,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_name"/>
                        </group>
                        <group>
                            <field name="order_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalle del Pedido" name="order_lines">
                            <field name="order_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="notes" placeholder="Ej: Sin picante"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </arch>
    </record>

    <!-- Vista Kanban (Estilo Tablero para la Cocina) -->
    <record id="view_food_order_kanban" model="ir.ui.view">
        <name>food.order.kanban</name>
        <model>food.order</model>
        <arch TYPE="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="amount_total"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_res_partner_kanban">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/> : <field name="customer_name"/>
                                </strong>
                                <div>
                                    <span>Total: </span><strong><field name="amount_total"/></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </arch>
    </record>

    <!-- Acción del Módulo -->
    <record id="action_food_order" model="ir.actions.act_window">
        <name>Pedidos del Puesto</name>
        <type>ir.actions.act_window</type>
        <res_model>food.order</res_model>
        <view_mode>list,kanban,form</view_mode>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primer pedido!
            </p>
        </help>
    </record>
</odoo>