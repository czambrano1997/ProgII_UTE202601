<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_comida_cliente_list" model="ir.ui.view">
        <field name="name">comida.cliente.list</field>
        <field name="model">comida.cliente</field>
        <field name="arch" type="xml">
            <list string="Clientes Registrados">
                <field name="name"/>
                <field name="telefono"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_comida_cliente_form" model="ir.ui.view">
        <field name="name">comida.cliente.form</field>
        <field name="model">comida.cliente</field>
        <field name="arch" type="xml">
            <form string="Cliente">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="telefono"/>
                        <field name="email"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_comida_cliente" model="ir.actions.act_window">
        <field name="name">Clientes del Local</field>
        <field name="res_model">comida.cliente</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>