<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="menu_view_form" model="ir.ui.view">
            <field name="name">menu.view.form</field>
            <field name="model">menu.view</field>
            <field name="arch" type="xml">
                <form string="Menu View">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <!-- Add your fields here -->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- List View -->
        <record id="menu_view_list" model="ir.ui.view">
            <field name="name">menu.view.list</field>
            <field name="model">menu.view</field>
            <field name="arch" type="xml">
                <list string="Menu View">
                    <field name="name"/>
                    <!-- Add your fields here -->
                </list>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_menu_view" model="ir.actions.act_window">
            <field name="name">Menu View</field>
            <field name="res_model">menu.view</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first menu view!
                </p>
            </field>
        </record>
        
        <!-- Menu -->
        <menuitem id="menu_menu_view"
                  name="Menu View"
                  action="action_menu_view"
                  sequence="10"/>
    </data>
</odoo>