<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_ute_complementos_user" model="res.groups">
        <field name="name">Usuario Complementos</field>
        <field name="privilege_id" ref="odoo_ute.res_groups_privilege_ute"/>
        <field name="implied_ids" eval="[(4, ref('odoo_ute.group_ute_user'))]"/>
    </record>

    <record id="group_ute_complementos_manager" model="res.groups">
        <field name="name">Administrador Complementos</field>
        <field name="privilege_id" ref="odoo_ute.res_groups_privilege_ute"/>
        <field name="implied_ids" eval="[(4, ref('group_ute_complementos_user')), (4, ref('odoo_ute.group_ute_manager'))]"/>
    </record>
</odoo>
