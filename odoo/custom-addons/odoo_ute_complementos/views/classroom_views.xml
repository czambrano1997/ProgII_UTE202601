<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ou_classroom_list" model="ir.ui.view">
        <field name="name">ou.classroom.list</field>
        <field name="model">ou.classroom</field>
        <field name="arch" type="xml">
            <list string="Aulas">
                <field name="code"/>
                <field name="name"/>
                <field name="building"/>
                <field name="floor"/>
                <field name="capacity"/>
                <field name="room_type"/>
                <field name="has_projector"/>
                <field name="has_computers"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ou_classroom_form" model="ir.ui.view">
        <field name="name">ou.classroom.form</field>
        <field name="model">ou.classroom</field>
        <field name="arch" type="xml">
            <form string="Aula">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="display_label" readonly="1"/>
                            <field name="room_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="building"/>
                            <field name="floor"/>
                            <field name="capacity"/>
                            <field name="has_projector"/>
                            <field name="has_computers"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observaciones">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ou_classroom" model="ir.actions.act_window">
        <field name="name">Aulas</field>
        <field name="res_model">ou.classroom</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
