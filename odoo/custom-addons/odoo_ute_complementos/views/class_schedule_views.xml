<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ou_class_schedule_list" model="ir.ui.view">
        <field name="name">ou.class.schedule.list</field>
        <field name="model">ou.class.schedule</field>
        <field name="arch" type="xml">
            <list string="Horarios">
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="signature_id"/>
                <field name="classroom_id"/>
                <field name="day_of_week"/>
                <field name="start_hour"/>
                <field name="end_hour"/>
                <field name="duration"/>
                <field name="modality"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ou_class_schedule_form" model="ir.ui.view">
        <field name="name">ou.class.schedule.form</field>
        <field name="model">ou.class.schedule</field>
        <field name="arch" type="xml">
            <form string="Horario">
                <sheet>
                    <group>
                        <group>
                            <field name="academic_plan_id"/>
                            <field name="teacher_id"/>
                            <field name="signature_id"/>
                            <field name="classroom_id"/>
                            <field name="modality"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="day_of_week"/>
                            <field name="start_hour"/>
                            <field name="end_hour"/>
                            <field name="duration" readonly="1"/>
                            <field name="name" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observaciones">
                            <field name="observations"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ou_class_schedule" model="ir.actions.act_window">
        <field name="name">Horarios</field>
        <field name="res_model">ou.class.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
