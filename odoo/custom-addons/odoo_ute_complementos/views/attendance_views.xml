<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ou_attendance_list" model="ir.ui.view">
        <field name="name">ou.attendance.list</field>
        <field name="model">ou.attendance</field>
        <field name="arch" type="xml">
            <list string="Asistencias">
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="signature_id"/>
                <field name="attendance_date"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours"/>
                <field name="status"/>
                <field name="justified"/>
            </list>
        </field>
    </record>

    <record id="view_ou_attendance_form" model="ir.ui.view">
        <field name="name">ou.attendance.form</field>
        <field name="model">ou.attendance</field>
        <field name="arch" type="xml">
            <form string="Asistencia">
                <sheet>
                    <group>
                        <group>
                            <field name="schedule_id"/>
                            <field name="teacher_id"/>
                            <field name="signature_id"/>
                            <field name="attendance_date"/>
                            <field name="status"/>
                            <field name="justified"/>
                        </group>
                        <group>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="worked_hours" readonly="1"/>
                            <field name="name" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ou_attendance" model="ir.actions.act_window">
        <field name="name">Asistencias</field>
        <field name="res_model">ou.attendance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
