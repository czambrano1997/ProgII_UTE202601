<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ou_academic_plan_list" model="ir.ui.view">
        <field name="name">ou.academic.plan.list</field>
        <field name="model">ou.academic.plan</field>
        <field name="arch" type="xml">
            <list string="Planes academicos">
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="signature_id"/>
                <field name="period"/>
                <field name="weekly_hours"/>
                <field name="total_weeks"/>
                <field name="total_hours"/>
                <field name="state"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ou_academic_plan_form" model="ir.ui.view">
        <field name="name">ou.academic.plan.form</field>
        <field name="model">ou.academic.plan</field>
        <field name="arch" type="xml">
            <form string="Plan academico">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="teacher_id"/>
                            <field name="signature_id"/>
                            <field name="period"/>
                            <field name="state"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="weekly_hours"/>
                            <field name="total_weeks"/>
                            <field name="total_hours" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Objetivo">
                            <field name="objective"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ou_academic_plan" model="ir.actions.act_window">
        <field name="name">Planes academicos</field>
        <field name="res_model">ou.academic.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
