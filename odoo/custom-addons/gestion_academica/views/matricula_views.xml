<odoo>
    <record id="view_gestion_matricula_list" model="ir.ui.view">
        <field name="name">gestion.matricula.list</field>
        <field name="model">gestion.matricula</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="estudiante_id"/>
                <field name="curso_id"/>
                <field name="fecha_matricula"/>
                <field name="estado"/>
                <field name="costo"/>
                <field name="descuento"/>
                <field name="total"/>
            </list>
        </field>
    </record>

    <record id="view_gestion_matricula_form" model="ir.ui.view">
        <field name="name">gestion.matricula.form</field>
        <field name="model">gestion.matricula</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="estudiante_id"/>
                        <field name="curso_id"/>
                        <field name="fecha_matricula"/>
                        <field name="estado"/>
                        <field name="costo"/>
                        <field name="descuento"/>
                        <field name="total"/>
                        <field name="materia_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gestion_matricula" model="ir.actions.act_window">
        <field name="name">Matrículas</field>
        <field name="res_model">gestion.matricula</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>