<odoo>
    <record id="view_gestion_estudiante_list" model="ir.ui.view">
        <field name="name">gestion.estudiante.list</field>
        <field name="model">gestion.estudiante</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="cedula"/>
                <field name="edad"/>
                <field name="email"/>
                <field name="activo"/>
                <field name="total_matriculas"/>
            </list>
        </field>
    </record>

    <record id="view_gestion_estudiante_form" model="ir.ui.view">
        <field name="name">gestion.estudiante.form</field>
        <field name="model">gestion.estudiante</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="nombres"/>
                        <field name="apellidos"/>
                        <field name="name" readonly="1"/>
                        <field name="cedula"/>
                        <field name="fecha_nacimiento"/>
                        <field name="edad"/>
                        <field name="genero"/>
                        <field name="email"/>
                        <field name="telefono"/>
                        <field name="activo"/>
                        <field name="total_matriculas"/>
                        <field name="observaciones"/>
                    </group>

                    <notebook>
                        <page string="Matrículas">
                            <field name="matricula_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gestion_estudiante" model="ir.actions.act_window">
        <field name="name">Estudiantes</field>
        <field name="res_model">gestion.estudiante</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>