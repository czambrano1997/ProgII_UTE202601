<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ou_conductor_form" model="ir.ui.view">
            <field name="name">Vista conductor Form</field>
            <field name="model">ou.conductor</field>
            <field name="arch" type="xml">
                <form string="Conductor">
                    <header>
                        <button name="generar_reporte" string="Generar reporte" class="oe_highlight" type="object"/>
<!--                        <field name="state" widget="statusbar" statusbar_visible="" statusbar_colors="{'KEY_IS_STATE':'VALUE_IS_COLOR'}"/>-->
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="last_name" />
                                <field name="vat" />
                            </group>
                            <group>
                                <field name="email" widget="email"/>
                                <field name="phone" widget="phone"/>
                                <field name="validate_email"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ou_conductor_tree" model="ir.ui.view">
            <field name="name">ou.conductor.tree</field>
            <field name="model">ou.conductor</field>
            <field name="arch" type="xml">
                <list string="Conductores">
                    <field name="name" />
                    <field name="last_name" />
                    <field name="vat" />
                </list>
            </field>
        </record>

        <record id="ou_conductor_action" model="ir.actions.act_window">
            <field name="name">Conductores</field>
            <field name="res_model">ou.conductor</field>
            <field name="view_mode">list,form</field> <!-- Se eliminó el punto inicial -->
        </record> <!-- Se eliminó el punto inicial -->

    </data>
</odoo>
