<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ute" model="ir.module.category">
        <field name="name">Gestión Académica UTE</field>
        <field name="sequence">50</field>
    </record>

    
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ute_admin'))]"/>
    </record>

    <record id="group_ute_usuario" model="res.groups">
        <field name="name">Usuario</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ute_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="implied_ids" eval="[(4, ref('group_ute_usuario'))]"/>
    </record>
</odoo>