<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        
        <record id="group_usuario_universidad" model="res.groups">
            <field name="name">Usuario Universidad</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
            <field name="comment">Usuario estándar de la Universidad - Solo lectura</field>
        </record>
        
        <record id="group_admin_universidad" model="res.groups">
            <field name="name">Administrador Universidad</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_usuario_universidad'))]" />
            <field name="comment">Administrador de la Universidad - Todos los permisos</field>
        </record>  
        
        
        
        
        <record id="carrera_rule_usuario_lectura" model="ir.rule">
            <field name="name">Carrera - Usuario: Lectura</field>
            <field name="model_id" ref="odoo_ute.model_universidad_carrera" />
            <field name="domain_force">[('id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('group_usuario_universidad'))]" />
            <field name="perm_read">True</field>
            <field name="perm_write">False</field>
            <field name="perm_create">False</field>
            <field name="perm_unlink">False</field>
        </record>
        
