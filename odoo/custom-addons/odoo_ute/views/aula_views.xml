<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_aula_form" model="ir.ui.view">
            <field name="name">ou.aula.form</field>
            <field name="model">ou.aula</field>
            <field name="arch" type="xml">
                <form string="Aula">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Nombre del aula..."/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="edificio"/>
                                <field name="capacidad"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_aula_list" model="ir.ui.view">
            <field name="name">ou.aula.list</field>
            <field name="model">ou.aula</field>
            <field name="arch" type="xml">
                <list string="Aulas">
                    <field name="name"/>
                    <field name="edificio"/>
                    <field name="capacidad"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="action_aula" model="ir.actions.act_window">
            <field name="name">Aulas</field>
            <field name="res_model">ou.aula</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Crear primera aula</p>
            </field>
        </record>
    </data>
</odoo>
