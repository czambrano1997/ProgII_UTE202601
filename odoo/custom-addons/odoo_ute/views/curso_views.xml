<odoo>
    <record id="view_gestion_curso_list" model="ir.ui.view">
        <field name="name">gestion.curso.list</field>
        <field name="model">gestion.curso</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="nivel"/>
                <field name="cupo_maximo"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="activo"/>
                <field name="total_matriculados"/>
            </list>
        </field>
    </record>

    <record id="view_gestion_curso_form" model="ir.ui.view">
        <field name="name">gestion.curso.form</field>
        <field name="model">gestion.curso</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="descripcion"/>
                        <field name="nivel"/>
                        <field name="cupo_maximo"/>
                        <field name="fecha_inicio"/>
                        <field name="fecha_fin"/>
                        <field name="activo"/>
                        <field name="total_matriculados"/>
                    </group>
                    <notebook>
                        <page string="Materias">
                            <field name="materia_ids"/>
                        </page>
                        <page string="Matrículas">
                            <field name="matricula_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gestion_curso" model="ir.actions.act_window">
        <field name="name">Cursos</field>
        <field name="res_model">gestion.curso</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>