<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_orden_pago_list" model="ir.ui.view">
    <field name="name">ute.orden.pago.list</field>
    <field name="model">ute.orden.pago</field>
    <field name="arch" type="xml">
      <list>
        <field name="estudiante_id"/>
        <field name="carrera_id"/>
        <field name="fecha_emision"/>
        <field name="monto"/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="view_orden_pago_form" model="ir.ui.view">
    <field name="name">ute.orden.pago.form</field>
    <field name="model">ute.orden.pago</field>
    <field name="arch" type="xml">
      <form string="Orden de Pago">
        <sheet>
          <group>
            <field name="estudiante_id"/>
            <field name="carrera_id"/>
            <field name="fecha_emision"/>
            <field name="monto"/>
            <field name="state"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_orden_pago" model="ir.actions.act_window">
    <field name="name">Órdenes de Pago</field>
    <field name="res_model">ute.orden.pago</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>