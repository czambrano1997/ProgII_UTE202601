<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista Lista -->
        <record id="grade_line_list" model="ir.ui.view">
            <field name="name">grade.line lista</field>
            <field name="model">grade.line</field>
            <field name="arch" type="xml">
                <list string="Notas">
                    <field name="student_id"/>
                    <field name="signature_id"/>
                    <field name="grade"/>
                </list>
            </field>
        </record>

        <!-- Vista Form -->
        <record id="grade_line_form" model="ir.ui.view">
            <field name="name">grade.line form</field>
            <field name="model">grade.line</field>
            <field name="arch" type="xml">
                <form string="Nota">
                    <sheet>
                        <group string="Datos">
                            <field name="student_id"/>
                            <field name="signature_id"/>
                            <field name="grade"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción -->
        <record id="grade_line_action" model="ir.actions.act_window">
            <field name="name">Notas</field>
            <field name="res_model">grade.line</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>