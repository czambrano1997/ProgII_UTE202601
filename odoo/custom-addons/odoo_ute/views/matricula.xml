<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_matricula_tree" model="ir.ui.view">
        <field name="name">ute.matricula.tree</field>
        <field name="model">ute.matricula</field>
        <field name="arch" type="xml">
            <list>
                <field name="estudiante_id"/>
                <field name="fecha"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_matricula_form" model="ir.ui.view">
        <field name="name">ute.matricula.form</field>
        <field name="model">ute.matricula</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="estudiante_id"/>
                        <field name="fecha"/>
                        <field name="estado"/>
                        <field name="aprobado"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_matricula" model="ir.actions.act_window">
        <field name="name">Matriculas</field>
        <field name="res_model">ute.matricula</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>