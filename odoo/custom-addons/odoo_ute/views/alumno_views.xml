<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Vista lista ─────────────────────────────────────────────── -->
        <record id="view_alumno_list" model="ir.ui.view">
            <field name="name">odoo_ute.alumno.list</field>
            <field name="model">odoo_ute.alumno</field>
            <field name="arch" type="xml">
                <list string="Alumnos">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="fecha_nacimiento"/>
                    <field name="promedio"/>
                    <field name="porcentaje_asistencia"/>
                </list>
            </field>
        </record>

        <!-- ── Vista formulario ───────────────────────────────────────── -->
        <record id="view_alumno_form" model="ir.ui.view">
            <field name="name">odoo_ute.alumno.form</field>
            <field name="model">odoo_ute.alumno</field>
            <field name="arch" type="xml">
                <form string="Alumno">
                    <sheet>
                        <group>
                            <group string="Datos personales">
                                <field name="nombre"/>
                                <field name="apellido"/>
                                <field name="email"/>
                                <field name="fecha_nacimiento"/>
                            </group>
                            <group string="Estadísticas">
                                <field name="promedio" readonly="1"/>
                                <field name="porcentaje_asistencia" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Calificaciones">
                                <field name="calificacion_ids" readonly="1">
                                    <list>
                                        <field name="curso_id"/>
                                        <field name="tipo_evaluacion"/>
                                        <field name="nota"/>
                                        <field name="fecha_evaluacion"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Asistencias">
                                <field name="asistencia_ids" readonly="1">
                                    <list>
                                        <field name="curso_id"/>
                                        <field name="fecha"/>
                                        <field name="presente"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ── Acción ─────────────────────────────────────────────────── -->
        <record id="action_alumno" model="ir.actions.act_window">
            <field name="name">Alumnos</field>
            <field name="res_model">odoo_ute.alumno</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
