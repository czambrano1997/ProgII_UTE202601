<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ou_authority_form" model="ir.ui.view">
            <field name="name">ou.authority.form</field>
            <field name="model">ou.authority</field>
            <field name="arch" type="xml">
                <form string="Autoridad">
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="active,inactive,retired"/>
                    </header>
                    <sheet>
                        <group string="Información Personal">
                            <group>
                                <field name="name"/>
                                <field name="last_name"/>
                                <field name="full_name"/>
                                <field name="role"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="email" widget="email"/>
                                <field name="phone" widget="phone"/>
                                <field name="career_id"/>
                                <field name="teacher_id"/>
                            </group>
                        </group>
                        <group string="Período en el cargo">
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                        </group>
                        <group string="Observaciones">
                            <field name="notes" nolabel="1"
                                   placeholder="Observaciones del cargo..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ou_authority_list" model="ir.ui.view">
            <field name="name">ou.authority.list</field>
            <field name="model">ou.authority</field>
            <field name="arch" type="xml">
                <list string="Autoridades">
                    <field name="full_name"/>
                    <field name="role"/>
                    <field name="career_id"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="state"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="action_ou_authority" model="ir.actions.act_window">
            <field name="name">Autoridades</field>
            <field name="res_model">ou.authority</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Registre la primera autoridad!
                </p>
            </field>
        </record>

    </data>
</odoo>
