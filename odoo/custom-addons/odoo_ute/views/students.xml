<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista Lista -->
        <record id="students_list" model="ir.ui.view">
            <field name="name">students lista</field>
            <field name="model">students.ute</field>
            <field name="arch" type="xml">
                <list string="Estudiantes">
                    <field name="name"/>
                    <field name="surnames"/>
                    <field name="age"/>
                    <field name="phone"/>
                    <field name="vat"/>
                </list>
            </field>
        </record>

        <!-- Vista Form -->
        <record id="students_form" model="ir.ui.view">
            <field name="name">students form</field>
            <field name="model">students.ute</field>
            <field name="arch" type="xml">
                <form string="Estudiante">
                    <sheet>
                        <group string="Datos Personales">
                            <field name="name"/>
                            <field name="surnames"/>
                            <field name="age"/>
                        </group>
                        <group string="Contacto">
                            <field name="phone"/>
                            <field name="vat"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción -->
        <record id="students_action" model="ir.actions.act_window">
            <field name="name">Estudiantes</field>
            <field name="res_model">students.ute</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>