<odoo>
    <data>
        <record id="action_ou_students" model="ir.actions.act_window">
            <field name="name">Estudiantes</field>
            <field name="res_model">ou.students</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_ou_students_list" model="ir.ui.view">
            <field name="name">ou.students.list</field>
            <field name="model">ou.students</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="surnames"/>
                    <field name="vat"/>
                </list>
            </field>
        </record>
    </data>
</odoo>