<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- TREE -->
  <record id="view_estudiante_tree" model="ir.ui.view">
    <field name="name">estudiante.tree</field>
    <field name="model">ute.estudiante</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="cedula"/>
        <field name="edad"/>
      </list>
    </field>
  </record>

  <!-- FORM -->
  <record id="view_estudiante_form" model="ir.ui.view">
    <field name="name">estudiante.form</field>
    <field name="model">ute.estudiante</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="cedula"/>
            <field name="edad"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ACTION -->
  <record id="action_estudiante" model="ir.actions.act_window">
    <field name="name">Estudiantes</field>
    <field name="res_model">ute.estudiante</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>