<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Vista lista ─────────────────────────────────────────────── -->
        <record id="view_maestro_list" model="ir.ui.view">
            <field name="name">odoo_ute.maestro.list</field>
            <field name="model">odoo_ute.maestro</field>
            <field name="arch" type="xml">
                <list string="Maestros">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="especialidad"/>
                    <field name="num_cursos"/>
                </list>
            </field>
        </record>

        <!-- ── Vista formulario ───────────────────────────────────────── -->
        <record id="view_maestro_form" model="ir.ui.view">
            <field name="name">odoo_ute.maestro.form</field>
            <field name="model">odoo_ute.maestro</field>
            <field name="arch" type="xml">
                <form string="Maestro">
                    <sheet>
                        <group>
                            <group string="Datos personales">
                                <field name="nombre"/>
                                <field name="apellido"/>
                                <field name="email"/>
                                <field name="especialidad"/>
                            </group>
                            <group string="Resumen">
                                <field name="num_cursos" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Cursos impartidos">
                                <field name="curso_ids" readonly="1">
                                    <list>
                                        <field name="nombre"/>
                                        <field name="creditos"/>
                                        <field name="num_calificaciones"/>
                                        <field name="promedio_curso"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ── Acción ─────────────────────────────────────────────────── -->
        <record id="action_maestro" model="ir.actions.act_window">
            <field name="name">Maestros</field>
            <field name="res_model">odoo_ute.maestro</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
