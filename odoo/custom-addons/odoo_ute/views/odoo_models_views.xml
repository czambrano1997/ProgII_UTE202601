                </form>
            </field>
        </record>

        <record id="ou_periodo_tree" model="ir.ui.view">
            <field name="name">ou.periodo.tree</field>
            <field name="model">ou.periodo</field>
            <field name="arch" type="xml">
                <tree string="Periodo">
                    <field name="name"/>
