<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Usuarios -->
        <record id="ou_usuarios_form" model="ir.ui.view">
            <field name="name">ou.usuarios.form</field>
            <field name="model">sistema.usuarios</field>
            <field name="arch" type="xml">
                <form string="Usuarios">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="last_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="vat"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ou_usuarios_tree" model="ir.ui.view">
            <field name="name">ou.usuarios.tree</field>
            <field name="model">sistema.usuarios</field>
            <field name="arch" type="xml">
                <tree string="Usuarios">
                    <field name="name"/>
                    <field name="last_name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="vat"/>
                </tree>
            </field>
        </record>

        <record id="action_ou_usuarios" model="ir.actions.act_window">
            <field name="name">Usuarios</field>
            <field name="res_model">sistema.usuarios</field>
            <field name="view_mode">tree,form</field>
        </record>

