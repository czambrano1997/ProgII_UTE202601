        <record id="action_ou_periodo" model="ir.actions.act_window">
            <field name="name">Periodos</field>
            <field name="res_model">ou.periodo</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Aula -->
        <record id="ou_aula_form" model="ir.ui.view">
