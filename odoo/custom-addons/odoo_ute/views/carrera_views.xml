<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_carrera_form" model="ir.ui.view">
            <field name="name">ou.carrera.form</field>
            <field name="model">ou.carrera</field>
            <field name="arch" type="xml">
                <form string="Carrera">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Nombre de la carrera..."/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="codigo"/>
                                <field name="modalidad" widget="radio"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_carrera_list" model="ir.ui.view">
            <field name="name">ou.carrera.list</field>
            <field name="model">ou.carrera</field>
            <field name="arch" type="xml">
                <list string="Carreras">
                    <field name="codigo"/>
                    <field name="name"/>
                    <field name="modalidad"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="action_carrera" model="ir.actions.act_window">
            <field name="name">Carreras</field>
            <field name="res_model">ou.carrera</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Crear primera carrera</p>
            </field>
        </record>
    </data>
</odoo>
