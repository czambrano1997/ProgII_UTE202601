<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="ou_periodo_form" model="ir.ui.view">
            <field name="name">ou.periodo.form</field>
            <field name="model">ou.periodo</field>
            <field name="arch" type="xml">
                <form string="Periodo Académico">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                            <field name="activo"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="ou_periodo_list" model="ir.ui.view">
            <field name="name">ou.periodo.list</field>
            <field name="model">ou.periodo</field>
            <field name="arch" type="xml">
                <list string="Periodos Académicos">
                    <field name="name"/>
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                    <field name="activo"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_ou_periodo" model="ir.actions.act_window">
            <field name="name">Periodos Académicos</field>
            <field name="res_model">ou.periodo</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Crea tu primer periodo académico!
                </p>
            </field>
        </record>
    </data>
</odoo>