<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_periodo_form" model="ir.ui.view">
            <field name="name">ou.periodo.form</field>
            <field name="model">ou.periodo</field>
            <field name="arch" type="xml">
                <form string="Período Académico">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Nombre del período..."/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="fecha_inicio"/>
                                <field name="fecha_fin"/>
                            </group>
                            <group>
                                <field name="activo" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_periodo_list" model="ir.ui.view">
            <field name="name">ou.periodo.list</field>
            <field name="model">ou.periodo</field>
            <field name="arch" type="xml">
                <list string="Períodos Académicos" decoration-muted="activo == False">
                    <field name="name"/>
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                    <field name="activo" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="action_periodo" model="ir.actions.act_window">
            <field name="name">Períodos Académicos</field>
            <field name="res_model">ou.periodo</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Crear primer período académico</p>
            </field>
        </record>
    </data>
</odoo>
