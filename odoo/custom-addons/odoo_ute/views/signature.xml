<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- forms -->
        <record id="ou_signature_form" model="ir.ui.view">
            <field name="name">ou.signature.form</field>
            <field name="model">ou.signature</field>
            <field name="arch" type="xml">
                <form string="Materia">
                    <sheet>
                        <group string="Información de la Materia">
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="level"/>
                                <field name="credits"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="career_id"/>
                                <field name="course_count"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Descripción">
                                <field name="description" placeholder="Descripción de la materia"/>
                            </page>
                            <page string="Docentes">
                                <field name="teacher_ids" widget="many2many_tags"/>
                            </page>
                            <page string="Cursos">
                                <field name="course_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="period"/>
                                        <field name="teacher_id"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- listas -->
        <record id="ou_signature_list" model="ir.ui.view">
            <field name="name">ou.signature.list</field>
            <field name="model">ou.signature</field>
            <field name="arch" type="xml">
                <list string="Materias">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="level"/>
                    <field name="credits"/>
                    <field name="career_id"/>
                    <field name="course_count"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- action -->
        <record id="action_ou_signature" model="ir.actions.act_window">
            <field name="name">Materias</field>
            <field name="res_model">ou.signature</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Registre la primera materia!
                </p>
            </field>
        </record>

    </data>
</odoo>
