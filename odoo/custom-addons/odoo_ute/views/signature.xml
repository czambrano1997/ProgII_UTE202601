<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="ou_signature_form" model="ir.ui.view">
            <field name="name">ou.signature.form</field>
            <field name="model">ou.signature</field>
            <field name="arch" type="xml">
                <form string="ou_signature">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <!-- Add your fields here -->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- List View -->
        <record id="ou_signature_list" model="ir.ui.view">
            <field name="name">ou.signature.list</field>
            <field name="model">ou.signature</field>
            <field name="arch" type="xml">
                <list string="ou_signature">
                    <field name="name"/>
                    <!-- Add your fields here -->
                </list>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_ou_signature" model="ir.actions.act_window">
            <field name="name">Materia</field>
            <field name="res_model">ou.signature</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first ou.signature!
                </p>
            </field>
        </record>
    
    </data>
</odoo>