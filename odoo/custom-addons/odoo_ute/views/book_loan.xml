<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="book_loan_list" model="ir.ui.view">
            <field name="name">Vista lista préstamo</field>
            <field name="model">book_loan.ute</field>
            <field name="arch" type="xml">
                <list string="Préstamos">
                    <field name="name"/>
                    <field name="book"/>
                    <field name="book_gender"/>
                    <field name="loan_date"/>
                </list>
            </field>
        </record>

        <record id="book_loan_form" model="ir.ui.view">
            <field name="name">Vista form préstamo</field>
            <field name="model">book_loan.ute</field>
            <field name="arch" type="xml">
                <form string="Préstamo de Libro">
                    <sheet>
                        <group string="Datos del préstamo">
                            <field name="name"/>
                            <field name="book"/>
                            <field name="book_gender" readonly="1"/>
                            <field name="loan_date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="book_loan_action" model="ir.actions.act_window">
            <field name="name">Préstamos</field>
            <field name="res_model">book_loan.ute</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>