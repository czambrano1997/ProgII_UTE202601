<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
<!-- forms -->
        <record id="ou_career_form" model="ir.ui.view">
            <field name="name">ou.career.form</field>
            <field name="model">ou.career</field>
            <field name="arch" type="xml">
                <form string="Carrera">
                    <sheet>
                        <group string="Información de la Carrera">
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="modality"/>
                                <field name="duration_years"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="coordinator_id"/>
                                <field name="signature_count"/>
                                <field name="student_count"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Descripción">
                                <field name="description" placeholder="Descripción de la carrera"/>
                            </page>
                            <page string="Materias">
                                <field name="signature_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="level"/>
                                        <field name="credits"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Estudiantes">
                                <field name="student_ids">
                                    <list>
                                        <field name="full_name"/>
                                        <field name="vat"/>
                                        <field name="state"/>
                                        <field name="gpa"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

<!-- listas -->
        <record id="ou_career_list" model="ir.ui.view">
            <field name="name">ou.career.list</field>
            <field name="model">ou.career</field>
            <field name="arch" type="xml">
                <list string="Carreras">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="modality"/>
                    <field name="duration_years"/>
                    <field name="coordinator_id"/>
                    <field name="signature_count"/>
                    <field name="student_count"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

<!-- actions -->
        <record id="action_ou_career" model="ir.actions.act_window">
            <field name="name">Carreras</field>
            <field name="res_model">ou.career</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ¡Registre la primera carrera!
                </p>
            </field>
        </record>

    </data>
</odoo>
