<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_matricula_pagada_list" model="ir.ui.view">
    <field name="name">ute.matricula.pagada.list</field>
    <field name="model">ute.matricula.pagada</field>
    <field name="arch" type="xml">
      <list>
        <field name="estudiante_id"/>
        <field name="carrera_id"/>
        <field name="fecha_pago"/>
        <field name="monto_pagado"/>
      </list>
    </field>
  </record>

  <record id="view_matricula_pagada_form" model="ir.ui.view">
    <field name="name">ute.matricula.pagada.form</field>
    <field name="model">ute.matricula.pagada</field>
    <field name="arch" type="xml">
      <form string="Matrícula Pagada">
        <sheet>
          <group>
            <field name="estudiante_id"/>
            <field name="carrera_id"/>
            <field name="fecha_pago"/>
            <field name="monto_pagado"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_matricula_pagada" model="ir.actions.act_window">
    <field name="name">Matrículas Pagadas</field>
    <field name="res_model">ute.matricula.pagada</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>