<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ou_teacher_form" model="ir.ui.view">
            <field name="name">Vista Docente Form</field>
            <field name="model">ou.teacher</field>
            <field name="arch" type="xml">
                <form string="Docente">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="last_name" />
                                <field name="vat" />
                                <field name="signature_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="email" widget="email"/>
                                <field name="phone" widget="phone"/>
                                <field name="validate_email"/>
                                <field name="signature_primary"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ou_teacher_tree" model="ir.ui.view">
            <field name="name">ou.teacher.tree</field>
            <field name="model">ou.teacher</field>
            <field name="arch" type="xml">
                <list string="Docente">
                    <field name="name" />
                    <field name="last_name" />
                    <field name="vat" />
                </list>
            </field>
        </record>

        <record id="ou_teacher_action" model="ir.actions.act_window">
            <field name="name">Docentes</field>
            <field name="res_model">ou.teacher</field>
            <field name="view_mode">list,form</field> <!-- Se eliminó el punto inicial -->
        </record> <!-- Se eliminó el punto inicial -->

    </data>
</odoo>
