<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ou_teacher_form" model="ir.ui.view">
            <field name="name">Vista Docente Form</field>
            <field name="model">ou.teacher</field>
            <field name="arch" type="xml">
                <form string="Docente">
                    <header>
                        <button name="generar_reporte" string="Generar reporte" class="oe_highlight" type="object"/>
<!--                        <field name="state" widget="statusbar" statusbar_visible="" statusbar_colors="{'KEY_IS_STATE':'VALUE_IS_COLOR'}"/>-->
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="last_name" />
                                <field name="vat" />
                                <field name="signature_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="email" widget="email"/>
                                <field name="phone" widget="phone"/>
                                <field name="validate_email"/>
                                <field name="signature_primary" groups="odoo_ute.group_ute_user" readonly="1"/>
                                <field name="signature_primary" groups="odoo_ute.group_ute_manager"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ou_teacher_list" model="ir.ui.view">
            <field name="name">ou.teacher.list</field>
            <field name="model">ou.teacher</field>
            <field name="arch" type="xml">
                <list string="Docente">
                    <field name="name" />
                    <field name="last_name" />
                    <field name="vat" />
                </list>
            </field>
        </record>

        <record id="ou_teacher_action" model="ir.actions.act_window">
            <field name="name">Docentes</field>
            <field name="res_model">ou.teacher</field>
            <field name="view_mode">list,form</field>
        </record> <!-- Se eliminó el punto inicial -->

    </data>
</odoo>
