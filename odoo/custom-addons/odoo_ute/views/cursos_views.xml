<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Vista lista ─────────────────────────────────────────────── -->
        <record id="view_cursos_list" model="ir.ui.view">
            <field name="name">odoo_ute_v2.cursos.list</field>
            <field name="model">odoo_ute_v2.cursos</field>
            <field name="arch" type="xml">
                <list string="Cursos">
                    <field name="nombre"/>
                    <field name="maestro_id"/>
                    <field name="creditos"/>
                    <field name="num_calificaciones"/>
                    <field name="promedio_curso"/>
                </list>
            </field>
        </record>

        <!-- ── Vista formulario ───────────────────────────────────────── -->
        <record id="view_cursos_form" model="ir.ui.view">
            <field name="name">odoo_ute_v2.cursos.form</field>
            <field name="model">odoo_ute_v2.cursos</field>
            <field name="arch" type="xml">
                <form string="Curso">
                    <sheet>
                        <group>
                            <group string="Información del curso">
                                <field name="nombre"/>
                                <field name="maestro_id"/>
                                <field name="creditos"/>
                            </group>
                            <group string="Estadísticas">
                                <field name="num_calificaciones" readonly="1"/>
                                <field name="promedio_curso" readonly="1"/>
                            </group>
                        </group>
                        <group string="Descripción">
                            <field name="descripcion" nolabel="1"/>
                        </group>
                        <notebook>
                            <page string="Calificaciones">
                                <field name="calificacion_ids" readonly="1">
                                    <list>
                                        <field name="alumno_id"/>
                                        <field name="tipo_evaluacion"/>
                                        <field name="nota"/>
                                        <field name="fecha_evaluacion"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Asistencias">
                                <field name="asistencia_ids" readonly="1">
                                    <list>
                                        <field name="alumno_id"/>
                                        <field name="fecha"/>
                                        <field name="presente"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ── Acción ─────────────────────────────────────────────────── -->
        <record id="action_cursos" model="ir.actions.act_window">
            <field name="name">Cursos</field>
            <field name="res_model">odoo_ute_v2.cursos</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
