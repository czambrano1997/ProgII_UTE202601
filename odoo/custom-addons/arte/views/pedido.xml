<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="pedido_form" model="ir.ui.view">
            <field name="name">pedido.form</field>
            <field name="model">arte.pedido</field>
            <field name="arch" type="xml">
                <form string="Pedido">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="cliente"></field>
                            <!-- Add your fields here -->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="pedido_list" model="ir.ui.view">
            <field name="name">pedido.list</field>
            <field name="model">arte.pedido</field>
            <field name="arch" type="xml">
                <list string="Pedido">
                    <field name="name"/>
                    <field name="cliente"></field>
                    <!-- Add your fields here -->
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_pedido" model="ir.actions.act_window">
            <field name="name">Pedido</field>
            <field name="res_model">arte.pedido</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first pedido!
                </p>
            </field>
        </record>


    </data>
</odoo>