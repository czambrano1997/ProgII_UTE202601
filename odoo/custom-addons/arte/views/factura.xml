<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="factura_form" model="ir.ui.view">
            <field name="name">factura.form</field>
            <field name="model">factura</field>
            <field name="arch" type="xml">
                <form string="Factura">
                    <sheet>
                        <group>
                            <field name="nombre"/>
                            <field name="pedido_id"/>
                            <field name="cliente"/>
                            <field name="correo"/>
                            <field name="telefono"/>
                            <!-- Add your fields here -->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- List View -->
        <record id="factura_list" model="ir.ui.view">
            <field name="name">factura.list</field>
            <field name="model">factura</field>
            <field name="arch" type="xml">
                <list string="Factura">
                     <field name="nombre"/>
                            <field name="pedido_id"/>
                            <field name="cliente"/>
                            <field name="correo"/>
                            <field name="telefono"/>
                    <!-- Add your fields here -->
                </list>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_factura" model="ir.actions.act_window">
            <field name="name">Factura</field>
            <field name="res_model">factura</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first factura!
                </p>
            </field>
        </record>
        
        <!-- Menu -->
       
    </data>
</odoo>