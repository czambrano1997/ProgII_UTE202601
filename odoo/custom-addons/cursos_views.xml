<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!-- Rol: Usuario UTE (docente / consulta) -->
    <record id="group_ute_usuario" model="res.groups">
        <field name="name">Usuario</field>
        <!-- Hereda base.group_user → puede iniciar sesión en el backend -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Rol: Administrador UTE (gestión completa) -->
    <record id="group_ute_admin" model="res.groups">
        <field name="name">Administrador</field>
        <!-- Hereda al Usuario → el admin siempre tiene todo lo que tiene el usuario -->
        <field name="implied_ids" eval="[(4, ref('group_ute_usuario'))]"/>
    </record>

</odoo>
