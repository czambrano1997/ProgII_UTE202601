<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_papeleria_venta_list" model="ir.ui.view">
        <field name="name">papeleria.venta.list</field>
        <field name="model">papeleria.venta</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="cliente_id"/>
                <field name="fecha"/>
                <field name="total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_papeleria_venta_form" model="ir.ui.view">
        <field name="name">papeleria.venta.form</field>
        <field name="model">papeleria.venta</field>
        <field name="arch" type="xml">
            <form string="Venta">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="borrador,confirmada,cancelada"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="cliente_id"/>
                        <field name="fecha"/>
                        <field name="total" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Productos">
                            <field name="lineas_venta">
                                <list editable="bottom">
                                    <field name="producto_id"/>
                                    <field name="cantidad"/>
                                    <field name="precio_unitario"/>
                                    <field name="subtotal" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                </form>
        </field>
    </record>

    <record id="view_papeleria_venta_search" model="ir.ui.view">
        <field name="name">papeleria.venta.search</field>
        <field name="model">papeleria.venta</field>
        <field name="arch" type="xml">
            <search string="Buscar Ventas">
                <field name="name"/>
                <field name="cliente_id"/>
            </search>
        </field>
    </record>

    <record id="action_papeleria_venta" model="ir.actions.act_window">
        <field name="name">Ventas</field>
        <field name="res_model">papeleria.venta</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_papeleria_venta_search"/>
    </record>
</odoo>