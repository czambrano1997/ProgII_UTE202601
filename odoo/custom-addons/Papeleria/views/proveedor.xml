<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Heredamos la vista form de res.partner para proveedores -->
    <record id="view_proveedor_papeleria_form" model="ir.ui.view">
        <field name="name">res.partner.proveedor.papeleria.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Datos del Proveedor" invisible="not es_proveedor_papeleria">
                    <field name="ruc"/>
                    <field name="plazo_entrega"/>
                </group>
                <group>
                    <field name="es_proveedor_papeleria"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Acción solo para proveedores de papelería -->
    <record id="action_proveedor_papeleria" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('es_proveedor_papeleria', '=', True)]</field>
        <field name="context">{'default_es_proveedor_papeleria': True}</field>
    </record>

</odoo>
