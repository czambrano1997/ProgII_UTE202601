<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_comida_tree" model="ir.ui.view">
        <field name="name">comida.tree</field>
        <field name="model">comida</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
                <field name="amount"/>
            </list>  <!-- Etiqueta corregida -->
        </field>
    </record>

    <record id="view_comida_form" model="ir.ui.view">
        <field name="name">comida.form</field>
        <field name="model">comida</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="state"/>
                        <field name="description"/>
                        <field name="amount"/>
                        <field name="active"/>
                    </group>
                    <footer>
                        <button string="Do Something" type="object" name="action_do_something" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_comida_root" name="Comida"/>

    <menuitem id="menu_comida_items" name="Comidas" parent="menu_comida_root"/>

    <record id="action_comida" model="ir.actions.act_window">
        <field name="name">Comidas</field>
        <field name="res_model">comida</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_comida_action" parent="menu_comida_items" action="action_comida"/>
</odoo>