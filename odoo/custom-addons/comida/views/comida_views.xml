<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="comida_view_list" model="ir.ui.view">
        <field name="name">comida.view.list</field>
        <field name="model">comida</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
                <field name="amount"/>
            </list>
        </field>
    </record>
    <record id="comida_view_form" model="ir.ui.view">
        <field name="name">comida.view.form</field>
        <field name="model">comida</field>
        <field name="arch" type="xml">
            <form string="Form">
                <header>
                    <button name="action_do_something" type="object" string="Do Something" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="state"/>
                        <field name="description"/>
                        <field name="amount"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="comida_view_kanban" model="ir.ui.view">
        <field name="name">comida.view.kanban</field>
        <field name="model">comida</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong><br/>
                            <field name="state"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="comida_view_search" model="ir.ui.view">
        <field name="name">comida.view.search</field>
        <field name="model">comida</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="state"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>
    <record id="action_comida" model="ir.actions.act_window">
        <field name="name">Comida</field>
        <field name="res_model">comida</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <menuitem id="menu_comida_root" name="Comida"/>
    <menuitem id="menu_comida_main" name="Records" parent="menu_comida_root" action="action_comida"/>
</odoo>