<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!-- Administrador: acceso total a todas las calificaciones -->
    <record id="rule_calificacion_admin" model="ir.rule">
        <field name="name">Calificación: acceso completo (admin)</field>
        <field name="model_id" ref="model_odoo_ute_calificacion"/>
        <field name="groups" eval="[(4, ref('odoo_ute.group_ute_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    
    <record id="rule_calificacion_usuario" model="ir.rule">
        <field name="name">Calificación: lectura y registro (usuario)</field>
        <field name="model_id" ref="model_odoo_ute_calificacion"/>
        <field name="groups" eval="[(4, ref('odoo_ute.group_ute_usuario'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    
    <!-- Administrador: acceso total a todos los registros de asistencia -->
    <record id="rule_asistencia_admin" model="ir.rule">
        <field name="name">Asistencia: acceso completo (admin)</field>
        <field name="model_id" ref="model_odoo_ute_asistencia"/>
        <field name="groups" eval="[(4, ref('odoo_ute.group_ute_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    
    <record id="rule_asistencia_usuario" model="ir.rule">
        <field name="name">Asistencia: lectura y registro (usuario)</field>
        <field name="model_id" ref="model_odoo_ute_asistencia"/>
        <field name="groups" eval="[(4, ref('odoo_ute.group_ute_usuario'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
