<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Custom Groups -->
        <record id="group_proyecto_security_user" model="res.groups">
            <field name="name">Proyecto Security User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Basic access to Proyecto Security</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="group_proyecto_security_manager" model="res.groups">
            <field name="name">Proyecto Security Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Full access to Proyecto Security</field>
            <field name="implied_ids" eval="[(4, ref('group_proyecto_security_user'))]"/>
        </record>
        
        <!-- Sample Users Data -->
        <record id="user_proyecto_security_demo_user" model="res.users">
            <field name="name">Proyecto Security Demo User</field>
            <field name="login">proyecto_security_demo_user</field>
            <field name="groups_id" eval="[(4, ref('group_proyecto_security_user'))]"/>
            <field name="password">proyecto_security_demo_user</field>
            <field name="email">proyecto_security_demo_user@example.com</field>
        </record>
    </data>
</odoo>