<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══════════════════════════════════════════════════════════
         Categoría del módulo
    ═══════════════════════════════════════════════════════════ -->
    <record id="module_category_concesionario" model="ir.module.category">
        <field name="name">Concesionario</field>
        <field name="description">Gestión de concesionario de vehículos</field>
        <field name="sequence">100</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         Grupo: Usuario (solo lectura)
    ═══════════════════════════════════════════════════════════ -->
    <record id="group_concesionario_usuario" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_concesionario"/>
        <field name="comment">Acceso de solo lectura a todos los modelos del concesionario.</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         Grupo: Administrador (todos los permisos)
    ═══════════════════════════════════════════════════════════ -->
    <record id="group_concesionario_administrador" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_concesionario"/>
        <field name="implied_ids" eval="[(4, ref('group_concesionario_usuario'))]"/>
        <field name="comment">Acceso total: crear, leer, modificar y eliminar registros del concesionario.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>