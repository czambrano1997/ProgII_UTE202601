<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_teatro_obra_tree" model="ir.ui.view">
        <field name="name">teatro.obra.tree</field>
        <field name="model">teatro.obra</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="genero"/>
                <field name="duracion_minutos"/>
                <field name="estado"/>
            </tree>
        </field>
    </record>

    <record id="view_teatro_obra_form" model="ir.ui.view">
        <field name="name">teatro.obra.form</field>
        <field name="model">teatro.obra</field>
        <field name="arch" type="xml">
            <form string="Obra de teatro">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="genero"/>
                        <field name="duracion_minutos"/>
                        <field name="estado"/>
                    </group>
                    <group>
                        <field name="descripcion"/>
                    </group>
                    <notebook>
                        <page string="Funciones">
                            <field name="funciones_ids">
                                <tree>
                                    <field name="fecha"/>
                                    <field name="hora_inicio"/>
                                    <field name="lugar"/>
                                    <field name="capacidad"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_teatro_obras" model="ir.actions.act_window">
        <field name="name">Obras</field>
        <field name="res_model">teatro.obra</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="menu_teatro_obras_action" model="ir.ui.menu">
        <field name="id">menu_teatro_obras_action</field>
        <field name="name">Obras</field>
        <field name="parent_id" ref="menu_teatro_root"/>
        <field name="action" ref="action_teatro_obras"/>
        <field name="sequence">10</field>
    </record>
</odoo>
