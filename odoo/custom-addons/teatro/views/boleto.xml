<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_teatro_boleto_tree" model="ir.ui.view">
        <field name="name">teatro.boleto.tree</field>
        <field name="model">teatro.boleto</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="funcion_id"/>
                <field name="cliente"/>
                <field name="asiento"/>
                <field name="precio"/>
                <field name="estado"/>
                <field name="fecha_compra"/>
            </tree>
        </field>
    </record>

    <record id="view_teatro_boleto_form" model="ir.ui.view">
        <field name="name">teatro.boleto.form</field>
        <field name="model">teatro.boleto</field>
        <field name="arch" type="xml">
            <form string="Boleto de teatro">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="funcion_id"/>
                        <field name="cliente"/>
                        <field name="asiento"/>
                        <field name="precio"/>
                        <field name="estado"/>
                        <field name="fecha_compra"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_teatro_boletos" model="ir.actions.act_window">
        <field name="name">Boletos</field>
        <field name="res_model">teatro.boleto</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="menu_teatro_boletos_action" model="ir.ui.menu">
        <field name="name">Boletos</field>
        <field name="parent_id" ref="menu_teatro_root"/>
        <field name="action" ref="action_teatro_boletos"/>
        <field name="sequence">30</field>
    </record>
</odoo>
