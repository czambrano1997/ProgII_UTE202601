<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista lista -->
    <record id="view_carrera_tree" model="ir.ui.view">
        <field name="name">ute.carrera.tree</field>
        <field name="model">ute.carrera</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="facultad"/>
                <field name="duracion"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="view_carrera_form" model="ir.ui.view">
        <field name="name">ute.carrera.form</field>
        <field name="model">ute.carrera</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="facultad"/>
                        <field name="duracion"/>
                        <field name="activa"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_carrera" model="ir.actions.act_window">
        <field name="name">Carreras</field>
        <field name="res_model">ute.carrera</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>