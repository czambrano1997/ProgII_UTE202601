<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Lista de historial médico -->
        <record id="view_historial_medico_list" model="ir.ui.view">
            <field name="name">patitas.unidas.historial_medico.list</field>
            <field name="model">patitas.unidas.historial_medico</field>
            <field name="arch" type="xml">
                <list string="Historial Médico">
                    <field name="pet_id"/>
                    <field name="date"/>
                    <field name="care_type"/>
                    <field name="description"/>
                    <field name="veterinarian"/>
                </list>
            </field>
        </record>

        <!-- Formulario de registro médico -->
        <record id="view_historial_medico_form" model="ir.ui.view">
            <field name="name">patitas.unidas.historial_medico.form</field>
            <field name="model">patitas.unidas.historial_medico</field>
            <field name="arch" type="xml">
                <form string="Registro Médico">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="pet_id" options="{'no_create': True}" required="1"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Datos de la Atención">
                                <field name="date"/>
                                <field name="care_type"/>
                                <field name="veterinarian"/>
                            </group>
                        </group>

                        <group string="Descripción">
                            <field name="description" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Acción ventana -->
        <record id="action_historial_medico" model="ir.actions.act_window">
            <field name="name">Historial Médico</field>
            <field name="res_model">patitas.unidas.historial_medico</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>