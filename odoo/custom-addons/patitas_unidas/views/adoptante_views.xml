<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Lista de adoptantes -->
        <record id="view_adoptante_list" model="ir.ui.view">
            <field name="name">patitas.unidas.adoptante.list</field>
            <field name="model">patitas.unidas.adoptante</field>
            <field name="arch" type="xml">
                <list string="Adoptantes">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="total_requests"/>
                    <field name="active_requests"/>
                </list>
            </field>
        </record>

        <!-- Formulario de adoptante -->
        <record id="view_adoptante_form" model="ir.ui.view">
            <field name="name">patitas.unidas.adoptante.form</field>
            <field name="model">patitas.unidas.adoptante</field>
            <field name="arch" type="xml">
                <form string="Adoptante">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nombre completo..." required="1"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Contacto">
                                <field name="email"/>
                                <field name="phone"/>
                            </group>
                            <group string="Estadísticas">
                                <field name="total_requests" readonly="1"/>
                                <field name="active_requests" readonly="1"/>
                            </group>
                        </group>

                        <group string="Dirección">
                            <field name="address" nolabel="1"/>
                        </group>

                        <!-- Solicitudes del adoptante (solo lectura, sin decoraciones) -->
                        <notebook>
                            <page string="Solicitudes">
                                <field name="adoption_requests_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="pet_id"/>
                                        <field name="request_date"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Acción ventana -->
        <record id="action_adoptante" model="ir.actions.act_window">
            <field name="name">Adoptantes</field>
            <field name="res_model">patitas.unidas.adoptante</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>