<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="base.group_system" model="res.groups" >
        <field name="implied_ids" eval="[4,ref('group_patitas_manager')]" />
    </record>
    <!-- Grupo: Usuario básico -->
    <record id="group_patitas_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Grupo: Administrador (acceso total) -->
    <record id="group_patitas_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="implied_ids" eval="[(4, ref('group_patitas_user'))]"/>
    </record>
</odoo>