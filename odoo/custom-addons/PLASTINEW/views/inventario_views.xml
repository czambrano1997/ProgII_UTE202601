<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_inventario_tree" model="ir.ui.view">
        <field name="name">plasticos.inventario.tree</field>
        <field name="model">plasticos.inventario</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="producto_id"/>
                <field name="tipo"/>
                <field name="cantidad"/>
                <field name="fecha"/>
                <field name="estado"/>
            </tree>
        </field>
    </record>

    <record id="view_inventario_form" model="ir.ui.view">
        <field name="name">plasticos.inventario.form</field>
        <field name="model">plasticos.inventario</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirmar" string="Confirmar" type="object" class="btn-primary"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="producto_id"/>
                        <field name="tipo"/>
                        <field name="cantidad"/>
                        <field name="stock_anterior"/>
                        <field name="stock_nuevo"/>
                        <field name="fecha"/>
                        <field name="ubicacion"/>
                        <field name="motivo"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_inventario" model="ir.actions.act_window">
        <field name="name">Inventario</field>
        <field name="res_model">plasticos.inventario</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>