<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cliente_tree" model="ir.ui.view">
        <field name="name">plasticos.cliente.tree</field>
        <field name="model">plasticos.cliente</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="rfc"/>
                <field name="email"/>
                <field name="tipo"/>
                <field name="estado"/>
                <field name="total_compras"/>
            </tree>
        </field>
    </record>

    <record id="view_cliente_form" model="ir.ui.view">
        <field name="name">plasticos.cliente.form</field>
        <field name="model">plasticos.cliente</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="rfc"/>
                        <field name="email"/>
                        <field name="telefono"/>
                        <field name="direccion"/>
                        <field name="tipo"/>
                        <field name="es_credito"/>
                        <field name="limite_credito"/>
                        <field name="estado"/>
                        <field name="total_compras"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cliente" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">plasticos.cliente</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>