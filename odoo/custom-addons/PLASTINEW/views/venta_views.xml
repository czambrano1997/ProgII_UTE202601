<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_venta_tree" model="ir.ui.view">
        <field name="name">plasticos.venta.tree</field>
        <field name="model">plasticos.venta</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="cliente_id"/>
                <field name="fecha"/>
                <field name="total"/>
                <field name="estado"/>
            </tree>
        </field>
    </record>

    <record id="view_venta_form" model="ir.ui.view">
        <field name="name">plasticos.venta.form</field>
        <field name="model">plasticos.venta</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirmar" string="Confirmar" type="object" class="btn-primary"/>
                    <button name="action_cancelar" string="Cancelar" type="object" class="btn-danger"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="cliente_id"/>
                        <field name="fecha"/>
                        <field name="metodo_pago"/>
                        <field name="subtotal"/>
                        <field name="impuestos"/>
                        <field name="total"/>
                        <field name="notas"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="producto_id"/>
                            <field name="cantidad"/>
                            <field name="precio_unitario"/>
                            <field name="subtotal"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_venta" model="ir.actions.act_window">
        <field name="name">Ventas</field>
        <field name="res_model">plasticos.venta</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>