<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="group_plasticos_usuario" model="res.groups">
        <field name="name">Plásticos / Usuario</field>
        <field name="category_id" ref="base.module_category_manufacturing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    
    <record id="group_plasticos_admin" model="res.groups">
        <field name="name">Plásticos / Administrador</field>
        <field name="category_id" ref="base.module_category_manufacturing"/>
        <field name="implied_ids" eval="[(4, ref('group_plasticos_usuario'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    
    <record id="rule_producto_usuario" model="ir.rule">
        <field name="name">Producto: Usuario solo activos</field>
        <field name="model_id" ref="model_plasticos_producto"/>
        <field name="domain_force">[('estado', '=', 'activo')]</field>
        <field name="groups" eval="[(4, ref('group_plasticos_usuario'))]"/>
    </record>

    <record id="rule_producto_admin" model="ir.rule">
        <field name="name">Producto: Admin todos</field>
        <field name="model_id" ref="model_plasticos_producto"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_plasticos_admin'))]"/>
    </record>
</odoo>