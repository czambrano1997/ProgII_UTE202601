<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_empleado_list" model="ir.ui.view">
        <field name="name">empleado.list</field>
        <field name="model">choco.empleado</field>
        <field name="arch" type="xml">
            <list string="Empleados">
                <field name="name"/>
                <field name="puesto"/>
                <field name="salario"/>
                <field name="activo"/>
            </list>
        </field>
    </record>

    <record id="view_empleado_form" model="ir.ui.view">
        <field name="name">empleado.form</field>
        <field name="model">choco.empleado</field>
        <field name="arch" type="xml">
            <form string="Empleado">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="puesto"/>
                        <field name="salario"/>
                        <field name="activo"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_empleado" model="ir.actions.act_window">
        <field name="name">Empleados</field>
        <field name="res_model">choco.empleado</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>