<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_producto_list" model="ir.ui.view">
        <field name="name">producto.list</field>
        <field name="model">choco.producto</field>
        <field name="arch" type="xml">
            <list string="Productos">
                <field name="nombre"/> <field name="tipo"/>   <field name="precio"/>
                <field name="stock"/>
                <field name="disponible"/> </list>
        </field>
    </record>

    <record id="view_producto_form" model="ir.ui.view">
        <field name="name">producto.form</field>
        <field name="model">choco.producto</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="nombre"/> <field name="tipo"/>   <field name="precio"/>
                        <field name="stock"/>
                        <field name="disponible"/> </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_producto" model="ir.actions.act_window">
        <field name="name">Productos</field>
        <field name="res_model">choco.producto</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>