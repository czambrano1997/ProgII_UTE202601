<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_cliente_tree" model="ir.ui.view">
        <field name="name">cliente.tree</field>
        <field name="model">choco.cliente</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre"/>
                <field name="telefono"/>
                <field name="correo"/>
            </list>
        </field>
    </record>

    <record id="view_cliente_form" model="ir.ui.view">
        <field name="name">cliente.form</field>
        <field name="model">choco.cliente</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="telefono"/>
                        <field name="correo"/>
                        <field name="fecha_registro"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cliente" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">choco.cliente</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>